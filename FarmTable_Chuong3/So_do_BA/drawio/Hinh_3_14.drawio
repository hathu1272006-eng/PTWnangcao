" x="195" y="685" width="245" height="120" /></mxCell><mxCell id="c11" value="Loại khỏi giỏ / từ chối mua&lt;br/&gt;Không trừ kho" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#243B32;strokeColor=#245C47;strokeWidth=1.6;fillColor=#FFFFFF;spacing=8;ellipse;strokeWidth=3;fillColor=#EEF6F1;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="710" width="340" height="75" /></mxCell><mxCell id="c12" value="Cho mua theo giá server&lt;br/&gt;Kiểm lại trong transaction" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#243B32;strokeColor=#245C47;strokeWidth=1.6;fillColor=#FFFFFF;spacing=8;ellipse;strokeWidth=3;fillColor=#EEF6F1;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="925" width="420" height="75" /></mxCell><mxCell id="c13" value="" edge="1" parent="1" source="c3" target="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;fontFamily=Arial;fontSize=15;fontColor=#243B32;labelBackgroundColor=#FFFFFF;strokeColor=#245C47;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c14" value="" edge="1" parent="1" source="c4" target="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;fontFamily=Arial;fontSize=15;fontColor=#243B32;labelBackgroundColor=#FFFFFF;strokeColor=#245C47;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c15" value="Không" edge="1" parent="1" source="c5" target="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;fontFamily=Arial;fontSize=15;fontColor=#243B32;labelBackgroundColor=#FFFFFF;strokeColor=#245C47;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;"><mxGeom